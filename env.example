# claude-tg configuration — copy to .env (docker compose reads it) and fill in.
# chmod 600 .env — it holds the bot token.

# Required — bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Recommended — comma-separated Telegram user ids allowed to drive the bot
ALLOWED_TELEGRAM_USER_IDS=

# Optional — proxy for Telegram API calls: http(s)://…, socks5(h)://… (PySocks),
# or "none" to force direct. Standard HTTP_PROXY/HTTPS_PROXY/NO_PROXY are also
# honoured when this is unset.
#TELEGRAM_HTTP_PROXY=

# Optional — forum-enabled group id: one topic per session
# (bot needs Manage Topics in that group; /chatid prints the id)
#TELEGRAM_FORUM_CHAT_ID=

# Optional — existing tmux session /new <dir> tmux adds windows to
#TMUX_SESSION=claude
